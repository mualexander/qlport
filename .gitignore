# secrets
.env

# python
__pycache__/
*.egg-info/
.pytest_cache/
.venv/

# notebooks: the .py (jupytext) file is the source of truth
notebooks/*.ipynb
.ipynb_checkpoints/

# latex build products (keep generated figures/tables, they are paper inputs)
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz

# derived data can be regenerated; raw recordings and the extracted corpus are committed
data/processed/*
!data/processed/.gitkeep

# downloaded dashboard trees: ~40 MB, re-fetchable from the commits pinned in
# data/corpus/SOURCES.md. data/corpus/queries.jsonl is what the notebooks read.
data/corpus/sources/
data/heldout/sources/

# Derived: `make paper` records by content which sources the build read.
paper/.sources.sha256
.mutate-cache/
