// Datadog metrics query grammar, v2. There is no published grammar; v1 (kept as
// datadog_v1.lark) was inferred from the documentation alone, and every production
// added here closes a gap that the integrations-core corpus exhibited -- see the
// repair table in paper §4, which measures v1 against the corpus.
//
//   sum:http.requests{status:5*,!env:dev} by {service}.as_rate().rollup(sum, 60)
//   abs(avg:system.load.1{*}) * 2
//   system.load.1{*}                                   // no space aggregator
//   count:slurm.sacct.enabled{*}                       // count / pNN aggregator
//   avg:gpu.sm_active{cloud_provider IN (aws,gcp) AND NOT *-zone}
//   sum:riak.node_gets{*},sum:riak.node_puts{*}        // several queries per request
//
// Built with parser="lalr": a conflict-free table is the mechanical proof that this
// grammar is LALR(1), hence unambiguous (RQ1).

?start: query_list

// A widget request may carry several comma-separated queries; the formulas-and-
// functions layer then refers to them positionally.
?query_list: expr
           | expr ("," expr)+                           -> query_list

?expr: term | expr ADDOP term                           -> binop
?term: unary | term MULOP unary                         -> binop
?unary: factor | ADDOP unary                            -> neg
?factor: query
       | NUMBER                                         -> number
       | FUNC "(" expr ("," arg)* ")"                   -> wrap
       | "(" expr ")"

// The space aggregator is optional: a bare metric name means avg: in the query
// editor, which the lowering layer has to supply rather than the grammar.
query: [space_agg ":"] METRIC scope [grouping] method*
space_agg: SPACEAGG

// ---- scope: a boolean tag query, not just a comma-separated list.
// Comma and AND are the same operator; AND binds tighter than OR, as in the
// Lucene-style filter syntax Datadog's editor accepts.
scope: "{" scope_expr "}"
?scope_expr: scope_or
// `,` and AND are one operator, so both spellings give a scope_and with exactly two
// children; the rule name carries the operator and the token is filtered out.
?scope_or: scope_and
         | scope_or _OR scope_and                       -> scope_or
?scope_and: scope_not
          | scope_and "," scope_not                     -> scope_and
          | scope_and _AND scope_not                    -> scope_and
?scope_not: scope_atom
          | NOT scope_not                               -> scope_not
?scope_atom: tag
           | "(" scope_expr ")"
           | membership
membership: TAG [NOT] IN "(" tag ("," tag)* ")"
// A tag term is `key`, `key:value` or `*`; `*` and `?` are wildcards and may appear
// in either half (`*-zone`, `code:4*`), so match-all is a lexical property of the
// term that the lowering layer resolves, not a separate production.
tag: TAG

grouping: BY "{" KEY ("," KEY)* "}"
method: "." FUNC "(" [arg ("," arg)*] ")"
?arg: signed_number | KEY -> word | STRING -> string
signed_number: [ADDOP] NUMBER

// ---- terminals. The aggregator keywords use a lookahead for the colon rather than
// consuming it, so a metric whose name starts with `sum.` still lexes as METRIC.
SPACEAGG.4: /(sum|avg|min|max|count|p\d{1,3})(?=\s*:)/
BY.4: /by\b/
// The tag-filter operators are case-insensitive in the corpus (`not x and *`), while
// the aggregator and method names above are not.
_AND.4: /(?i:and)\b/
_OR.4: /(?i:or)\b/
NOT.4: /!|(?i:not)\b/
IN.4: /(?i:in)\b(?=\s*\()/
FUNC.2: /[a-z_][a-z0-9_]*(?=\s*\()/
METRIC.1: /[a-zA-Z][a-zA-Z0-9_.]*/
TAG: /[a-zA-Z0-9_.\-\/*?]+(:[a-zA-Z0-9_.\-\/*?:]*)?/
KEY: /[a-zA-Z][a-zA-Z0-9_.\-\/]*/
NUMBER: /[0-9]+(\.[0-9]+)?/
STRING: /"([^"\\]|\\.)*"/ | /'([^'\\]|\\.)*'/
ADDOP: "+" | "-"
MULOP: "*" | "/"

%ignore /\s+/
