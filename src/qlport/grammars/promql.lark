// PromQL core grammar, v2. Precedence is encoded in the rule levels, lowest first,
// as in Rich Example 11.19. Built with parser="lalr": a conflict-free table is the
// mechanical proof that this grammar is LALR(1), hence unambiguous.
// Source of truth to compare against: prometheus/promql/parser/generated_parser.y
// and lex.go. v1 (kept as promql_v1.lark) is the starter grammar the gap table of
// paper §4 measures against the corpus.

?start: expr

?expr: or_expr
?or_expr: and_expr | or_expr OR modifiers and_expr                 -> binop
?and_expr: cmp_expr | and_expr SETOP modifiers cmp_expr            -> binop
?cmp_expr: add_expr | cmp_expr CMPOP modifiers add_expr            -> binop
?add_expr: mul_expr | add_expr ADDOP modifiers mul_expr            -> binop
?mul_expr: unary | mul_expr MULOP modifiers unary                  -> binop
?unary: pow_expr | ADDOP unary                                     -> neg
?pow_expr: postfix | postfix POW modifiers unary                   -> binop   // right-assoc

modifiers: [BOOL] [matching]
matching: (ON | IGNORING) "(" [label_list] ")" [group]
group: (GROUP_LEFT | GROUP_RIGHT) ["(" [label_list] ")"]

// Negative offsets are accepted since Prometheus 2.25; the @ modifier since 2.56
// takes a unix timestamp or start()/end(). No corpus query uses @, which is itself
// worth reporting: the construct exists but shipped dashboards do not reach for it.
?postfix: atom
        | postfix "[" DURATION "]"                     -> range
        | postfix "[" DURATION ":" [DURATION] "]"      -> subquery
        | postfix OFFSET [ADDOP] DURATION              -> offset
        | postfix AT at_arg                            -> at
at_arg: [ADDOP] NUMBER | FUNC "(" ")"

?atom: NUMBER                                          -> number
     | STRING                                          -> string
     | selector
     | aggregation
     | call
     | "(" expr ")"

selector: METRIC [label_matchers] | label_matchers
label_matchers: "{" [matcher ("," matcher)* [","]] "}"
// A UTF-8 label name is written as a string literal (Prometheus 3.0), and a bare
// string in the list is the metric name. Upstream's own grammar also accepts the
// bare form anywhere in the list and rejects a misplaced one after parsing, so the
// position rule is deliberately left out of the grammar here too.
matcher: LABEL MATCHOP STRING
       | STRING MATCHOP STRING
       | STRING                                        -> metric_name

aggregation: AGGOP grouping "(" args ")"
           | AGGOP "(" args ")" [grouping]
grouping: (BY | WITHOUT) "(" [label_list] ")"
call: FUNC "(" [args] ")"
args: expr ("," expr)*
label_list: label_name ("," label_name)*
label_name: LABEL | STRING

// ---- terminals. Keywords get priority over identifiers and need \b, otherwise
// max_over_time lexes as MAX + "_over_time" and group_left as GROUP + "_left".
// Keywords and aggregation operators are case-insensitive (lex.go looks them up
// through strings.ToLower); function names are not, because the parser resolves
// those against an exact-match table in functions.go.
AGGOP.3: /(?i:sum|avg|min|max|count_values|count|stddev|stdvar|topk|bottomk|quantile|group)\b/
OR.3: /(?i:or)\b/
SETOP.3: /(?i:and|unless)\b/
BY.3: /(?i:by)\b/
WITHOUT.3: /(?i:without)\b/
ON.3: /(?i:on)\b/
IGNORING.3: /(?i:ignoring)\b/
GROUP_LEFT.3: /(?i:group_left)\b/
GROUP_RIGHT.3: /(?i:group_right)\b/
OFFSET.3: /(?i:offset)\b/
BOOL.3: /(?i:bool)\b/

FUNC.2: /[a-z_][a-z0-9_]*(?=\s*\()/
METRIC: /[a-zA-Z_:][a-zA-Z0-9_:]*/
LABEL: /[a-zA-Z_][a-zA-Z0-9_]*/

DURATION.2: /([0-9]+(ms|s|m|h|d|w|y))+/
// A float may omit the digits before the point (.95).
NUMBER: /([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?/
// Backtick-quoted strings are raw: no escape processing, newlines allowed.
STRING: /"([^"\\]|\\.)*"/ | /'([^'\\]|\\.)*'/ | /`[^`]*`/

MATCHOP: "=~" | "!~" | "!=" | "="
CMPOP: "==" | "!=" | "<=" | ">=" | "<" | ">"
ADDOP: "+" | "-"
MULOP: /\*|\/|%|(?i:atan2)\b/
POW: "^"
AT: "@"

%ignore /\s+/
%ignore /#[^\n]*/
